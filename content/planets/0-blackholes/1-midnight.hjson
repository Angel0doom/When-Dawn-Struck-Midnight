localizedName: Midnight
// Using NoiseMesh layers to build a glowing accretion disk around the void core
mesh: [
  // LAYER 1: The Accretion Disk / Outer Corona
  {
    type: NoiseMesh
    divisions: 6
    radius: 0.95        // Significantly larger than the core to create a wide glowing ring
    octaves: 6          // High detail for swirling solar-flare textures
    persistence: 0.8    // High roughness to make the edges look chaotic and jagged
    scl: 0.9            // Fine-grained noise scale for a gaseous, plasma look
    mag: 1.5            // High distortion to make the ring visually warp around the sphere
    colorScale: 2
    colors: [
      84f491           // Using your signature support green for the outer plasma tail!
      2b8e45           // Darker green gradient
      0a3014           // Deep forest green fading into the void
    ]
  }
  
  // LAYER 2: The Intense Photon Ring Inner Edge
  {
    type: NoiseMesh
    divisions: 5
    radius: 0.65        // Sits right on the lip of the event horizon
    octaves: 4
    persistence: 0.5
    scl: 1.5
    mag: 0.4            // Tamer distortion so it hugs the center perfectly
    colors: [
      ffffff           // Blinding pure white where gravity is tearing matter apart
      84f491           // Fading back into the green corona
    ]
  }

  // LAYER 3: The Event Horizon (Your Black Core)
  {
    type: SunMesh       // Keeps its smooth shape
    divisions: 7
    radius: 0.55        // Smallest radius so it covers the center of the glowing layers
    octaves: 1          // Low octaves so it stays perfectly uniform
    persistence: 0.1
    scl: 1
    pow: 1
    mag: 0
    colorScale: 1
    colors: [
      000000           // Absolute void
      000000
    ]
  }
]

accessible: false
alwaysUnlocked: true
visible: true
hasAtmosphere: false
bloom: true            // Essential! Makes the white and green layers intensely bleed light
orbitSpacing: 0.2
solarSystem: 1-midnight
radius: 1.5
drawOrbit: false
parent: sun
orbitRadius: 12000
